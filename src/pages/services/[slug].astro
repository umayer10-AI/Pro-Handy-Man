---
import { ArrowRight, ArrowLeft, CheckCircle2, Phone, Award, Star } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOSections from '@/components/SEOSections.astro';
import { ALL_SERVICES, SERVICES, SUBSERVICES } from '@/data/services.js';
import { ALL_TESTIMONIALS, AWARDS, reviewsSchema } from '@/data/seoSections.js';

export function getStaticPaths() {
  const seen = new Set();
  return ALL_SERVICES
    .filter((service) => {
      if (seen.has(service.slug)) return false;
      seen.add(service.slug);
      return true;
    })
    .map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const Icon = service.icon;
const children = SUBSERVICES.filter((s) => s.parent === service.slug);
const gridServices = SERVICES.filter((s) => s.slug !== service.slug && s.slug !== service.parent);
const siblings = service.parent ? SUBSERVICES.filter((s) => s.parent === service.parent && s.slug !== service.slug) : [];
const parentMain = service.parent ? SERVICES.find((s) => s.slug === service.parent) : null;
const related = [
  ...(parentMain ? [parentMain] : []),
  ...(siblings.length ? siblings : SERVICES.filter((s) => s.slug !== service.slug)),
].slice(0, 4);

const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name + ' Singapore',
  description: service.intro,
  provider: {
    '@type': 'LocalBusiness',
    name: 'Pro Handyman SG.Com',
    url: 'https://prohandymansg.com',
    telephone: '+6585979456',
    areaServed: { '@type': 'Country', name: 'Singapore' },
  },
  areaServed: { '@type': 'Country', name: 'Singapore' },
};

const schemaFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title={`${service.name} Services in Singapore — Licensed Handymen | Pro Handyman SG.Com`}
  description={`${service.tagline} Pro Handyman SG.Com provides professional ${service.name.toLowerCase()} services for HDB flats and condos across Singapore. Free quotes, same-day slots.`}
  keywords={`${service.keywords}, handyman Singapore, home repair Singapore, HDB ${service.name.toLowerCase()} Singapore`}
  canonical={`https://prohandymansg.com/services/${service.slug}`}
  schemas={[schemaService, schemaFAQ, reviewsSchema(ALL_TESTIMONIALS)]}
>
  <section class="relative pt-28 pb-20 overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img src={service.img} alt={`Professional ${service.name.toLowerCase()} service for HDB flats and condos in Singapore — Pro Handyman SG.Com`} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-background via-background/95 to-background/60"></div>
    </div>
    <div class="mx-auto max-w-[72rem] px-5">
      <div class="flex flex-wrap items-center gap-2 text-sm font-medium text-muted-foreground">
        <a href="/#services" class="inline-flex items-center gap-1.5 hover:text-foreground transition"><ArrowLeft class="w-4 h-4" /> All services</a>
        {parentMain && (
          <>
            <span class="text-border">/</span>
            <a href={`/services/${parentMain.slug}`} class="hover:text-foreground transition">{parentMain.name}</a>
          </>
        )}
      </div>
      <div class="max-w-2xl mt-5 reveal-scale is-visible">
        <span class="inline-flex items-center gap-2 rounded-full border border-primary/15 bg-secondary/85 px-4 py-1.5 text-xs font-bold text-primary shadow-sm">
          <Icon class="w-3.5 h-3.5" /> {service.name}
        </span>
        <h1 class="font-display font-extrabold tracking-tight text-4xl md:text-5xl leading-tight mt-5">{service.name} services in Singapore</h1>
        <p class="mt-4 text-lg text-muted-foreground">{service.tagline}</p>
        <a href="/#contact" class="mt-7 inline-flex items-center gap-2 rounded-full bg-primary text-primary-foreground px-6 py-3.5 font-semibold hover:brightness-110 active:scale-[0.98] transition">
          Request a Free Quote <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-[56rem] px-5">
      <p class="text-lg leading-relaxed text-foreground/90 reveal">{service.intro}</p>
      <div class="mt-12 space-y-12">
        {service.sections.map((sec) => (
          <section class="reveal">
            <h2 class="font-display font-bold text-2xl md:text-3xl">{sec.h}</h2>
            <p class="mt-3 text-muted-foreground leading-relaxed">{sec.p}</p>
          </section>
        ))}
      </div>

      {children.length > 0 && (
        <div class="mt-14 reveal">
          <h2 class="font-display font-bold text-2xl md:text-3xl">{service.name} sub-services we provide in Singapore</h2>
          <p class="mt-3 text-muted-foreground">Explore our specialised {service.name.toLowerCase()} services below — each with its own dedicated page and detailed information.</p>
          <div class="mt-6 grid sm:grid-cols-2 gap-3">
            {children.map((c) => {
              const ChildIcon = c.icon;
              return (
                <a href={`/services/${c.slug}`} class="group flex items-start gap-3 rounded-2xl border border-border/80 bg-card p-4 hover:shadow-lg hover:-translate-y-0.5 transition">
                  <span class="grid place-items-center w-9 h-9 rounded-lg bg-secondary text-primary shrink-0"><ChildIcon class="w-4 h-4" /></span>
                  <span>
                    <span class="block font-display font-semibold text-sm group-hover:text-primary transition">{c.name}</span>
                    <span class="block text-xs text-muted-foreground mt-0.5">{c.desc}</span>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <div class="mt-12 rounded-[1.35rem] bg-secondary/50 border border-border/80 p-6 shadow-sm reveal-scale">
        <h2 class="font-display font-bold text-xl mb-4">Also useful</h2>
        <ul class="space-y-2 text-sm">
          {related.map((s) => (
            <li><a href={`/services/${s.slug}`} class="flex items-center gap-2 text-primary font-medium hover:underline"><ArrowRight class="w-3.5 h-3.5" /> {s.name} services in Singapore</a></li>
          ))}
          <li><a href="/blog" class="flex items-center gap-2 text-primary font-medium hover:underline"><ArrowRight class="w-3.5 h-3.5" /> Home care tips &amp; guides blog</a></li>
        </ul>
      </div>

      <div class="mt-12 reveal">
        <h2 class="font-display font-bold text-2xl md:text-3xl">Frequently asked questions about {service.name.toLowerCase()} in Singapore</h2>
        <div class="mt-6 divide-y divide-border rounded-[1.35rem] border border-border/80 bg-card shadow-sm">
          {service.faqs.map((f) => (
            <div class="p-6">
              <h3 class="font-semibold flex items-start gap-2"><CheckCircle2 class="w-5 h-5 text-accent shrink-0 mt-0.5" /> {f.q}</h3>
              <p class="mt-2 text-sm text-muted-foreground pl-7">{f.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-14 rounded-[1.35rem] bg-secondary/50 border border-border/80 p-6 shadow-sm reveal-scale">
        <h2 class="font-display font-bold text-xl mb-4 flex items-center gap-2"><Award class="w-5 h-5 text-accent" /> Awards &amp; trust badges</h2>
        <div class="flex flex-wrap gap-3">
          {AWARDS.map((a) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium">
              <Star class="w-3.5 h-3.5 text-accent fill-current" /> {a.title} {a.year}
            </span>
          ))}
        </div>
      </div>

      <div class="mt-16 rounded-[1.75rem] bg-primary text-primary-foreground p-8 sm:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 shadow-2xl reveal-scale">
        <div>
          <h2 class="font-display font-bold text-2xl">Need {service.name.toLowerCase()} help today?</h2>
          <p class="mt-2 text-primary-foreground/80">Upfront quotes, licensed handymen, islandwide across Singapore.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/#contact" class="inline-flex items-center gap-2 rounded-full bg-accent text-accent-foreground px-6 py-3.5 font-semibold hover:brightness-95 active:scale-[0.98] transition">Get a Quote</a>
          <a href="tel:+6585979456" class="inline-flex items-center gap-2 rounded-full border border-primary-foreground/30 px-6 py-3.5 font-semibold hover:bg-primary-foreground/10 transition"><Phone class="w-4 h-4" /> Call us</a>
        </div>
      </div>
    </div>
  </section>

  <SEOSections sections={['testimonials', 'portfolio']} testimonialLimit={4} testimonialTitle={`What customers say about our ${service.name.toLowerCase()} service`} testimonialSubtitle="Rated 4.9 stars by Singapore homeowners across HDB flats and condos islandwide." portfolioLimit={3} />

  <section class="pb-20">
    <div class="mx-auto max-w-[72rem] px-5">
      <h2 class="font-display font-bold text-2xl mb-6">Explore other services</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {gridServices.map((s) => {
          const GridIcon = s.icon;
          return (
            <a href={`/services/${s.slug}`} class="group flex items-center gap-3 rounded-2xl border border-border/80 bg-card p-4 hover:shadow-lg hover:-translate-y-0.5 transition">
              <span class="grid place-items-center w-10 h-10 rounded-lg bg-secondary text-primary"><GridIcon class="w-5 h-5" /></span>
              <span class="font-display font-semibold group-hover:text-primary transition">{s.name}</span>
              <ArrowRight class="w-4 h-4 ml-auto text-muted-foreground group-hover:translate-x-1 transition" />
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
