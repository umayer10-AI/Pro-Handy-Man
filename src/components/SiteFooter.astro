---
import { Phone, Mail, MapPin, Clock, ArrowRight, ShieldCheck, Star, Wrench } from '@lucide/astro';
import { SERVICES } from '@/data/services.js';
import Logo from './Logo.astro';
const AREAS = ['Tampines', 'Jurong', 'Woodlands', 'Bishan', 'Bedok', 'Queenstown', 'Punggol', 'Sengkang', 'Clementi', 'Toa Payoh', 'Yishun', 'Serangoon'];
const half = Math.ceil(SERVICES.length / 2);
const year = new Date().getFullYear();
---

<footer class="bg-primary text-primary-foreground dark:bg-[#013a63]">
  <div class="border-b border-primary-foreground/15">
    <div class="mx-auto max-w-[72rem] px-5 py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <h3 class="font-display font-extrabold text-2xl md:text-3xl">Need a reliable handyman in Singapore?</h3>
        <p class="text-primary-foreground/70 mt-2">Upfront quotes, licensed pros, same-day and weekend slots islandwide.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/#contact" class="inline-flex items-center gap-2 rounded-full bg-accent text-accent-foreground px-6 py-3 font-semibold hover:brightness-95 active:scale-[0.98] transition">
          Get a Free Quote <ArrowRight class="w-4 h-4" />
        </a>
        <a href="tel:+6585979456" class="inline-flex items-center gap-2 rounded-full border border-primary-foreground/30 px-6 py-3 font-semibold hover:bg-primary-foreground/10 transition">
          <Phone class="w-4 h-4" /> +65 8597 9456
        </a>
      </div>
    </div>
  </div>
  <div class="mx-auto max-w-[72rem] px-5 py-14 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4">
      <Logo variant="light" />
      <p class="text-sm text-primary-foreground/70 mt-4 max-w-xs leading-relaxed">
        Pro Handyman SG.Com delivers reliable, licensed handyman, repair and installation services for HDB flats, condos and landed homes across Singapore.
      </p>
      <div class="mt-5 space-y-2.5 text-sm text-primary-foreground/80">
        <p class="flex items-center gap-2.5"><Phone class="w-4 h-4 text-accent shrink-0" /> +65 8597 9456</p>
        <p class="flex items-center gap-2.5"><Mail class="w-4 h-4 text-accent shrink-0" /> support@prohandymansg.com</p>
        <p class="flex items-center gap-2.5"><MapPin class="w-4 h-4 text-accent shrink-0" /> Islandwide, Singapore</p>
        <p class="flex items-center gap-2.5"><Clock class="w-4 h-4 text-accent shrink-0" /> Mon–Sun, 8am–10pm</p>
      </div>
    </div>
    <div class="md:col-span-5 grid grid-cols-2 gap-6">
      <div>
        <h4 class="font-display font-semibold mb-3 text-sm uppercase tracking-wide text-primary-foreground/90">Services</h4>
        <ul class="space-y-2 text-sm text-primary-foreground/70">
          {SERVICES.slice(0, half).map((s) => <li><a href={`/services/${s.slug}`} class="hover:text-accent transition">{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h4 class="font-display font-semibold mb-3 text-sm uppercase tracking-wide text-primary-foreground/90 md:mt-8">&nbsp;</h4>
        <ul class="space-y-2 text-sm text-primary-foreground/70 md:-mt-8">
          {SERVICES.slice(half).map((s) => <li><a href={`/services/${s.slug}`} class="hover:text-accent transition">{s.name}</a></li>)}
          <li><a href="/blog" class="hover:text-accent transition font-medium">Blog &amp; Guides</a></li>
        </ul>
      </div>
    </div>
    <div class="md:col-span-3">
      <h4 class="font-display font-semibold mb-3 text-sm uppercase tracking-wide text-primary-foreground/90">Areas we serve</h4>
      <div class="flex flex-wrap gap-2">
        {AREAS.map((a) => <span class="text-xs rounded-full border border-primary-foreground/20 px-3 py-1 text-primary-foreground/70">{a}</span>)}
      </div>
      <div class="mt-6 space-y-2.5 text-sm text-primary-foreground/80">
        <p class="flex items-center gap-2"><ShieldCheck class="w-4 h-4 text-accent" /> Licensed &amp; insured</p>
        <p class="flex items-center gap-2"><Star class="w-4 h-4 text-accent" /> 4.9 stars, 1,200+ homes</p>
        <p class="flex items-center gap-2"><Wrench class="w-4 h-4 text-accent" /> Upfront, honest pricing</p>
      </div>
    </div>
  </div>
  <div class="border-t border-primary-foreground/15 py-5">
    <div class="mx-auto max-w-[72rem] px-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-primary-foreground/60">
      <p>© {year} Pro Handyman SG.Com — All rights reserved.</p>
      <p>Handyman services for HDB, condo &amp; landed homes across Singapore.</p>
    </div>
  </div>
</footer>
