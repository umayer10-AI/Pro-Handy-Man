---
import { ArrowRight, Menu, X, ChevronDown, Moon, Sun } from '@lucide/astro';
import { NAV_GROUPS } from '@/data/services.js';
import Logo from './Logo.astro';
---

<header data-site-header class="fixed top-3 inset-x-0 z-50 px-3 pointer-events-none transition-all duration-300">
  <div class="pointer-events-auto mx-auto max-w-[72rem] px-4 sm:px-5 h-16 flex items-center justify-between gap-3 rounded-[1.35rem] border border-border/75 bg-card/82 shadow-[0_18px_48px_hsl(var(--foreground)/0.10)] backdrop-blur-2xl">
    <a href="/" aria-label="Pro Handyman SG.Com home" class="shrink-0 transition-transform duration-300 hover:scale-[1.02]">
      <Logo variant="solid" />
    </a>
    <nav class="hidden lg:flex items-center gap-1 rounded-full border border-border/70 bg-background/60 px-1.5 py-1 text-xs font-semibold shadow-sm backdrop-blur">
      <div class="relative" data-services-menu-root>
        <button type="button" data-services-menu-button aria-expanded="false" class="flex items-center gap-1 rounded-full px-4 py-2 text-muted-foreground hover:bg-card hover:text-foreground transition-colors data-[active=true]:bg-card data-[active=true]:text-foreground">
          Services <ChevronDown data-services-menu-chevron class="w-4 h-4 transition-transform" />
        </button>
        <div data-services-menu data-open="false" class="invisible pointer-events-none fixed left-1/2 top-[5.35rem] z-50 w-[calc(100vw-1.5rem)] max-w-[68rem] -translate-x-1/2 translate-y-2 scale-[0.98] transition-all duration-200 ease-out data-[open=true]:visible data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 data-[open=true]:scale-100">
          <div class="rounded-[1.25rem] border border-border/80 bg-[#ffffff] p-3 shadow-2xl dark:bg-[#000000]">
            <div class="grid max-h-[min(72vh,38rem)] grid-cols-2 gap-2 overflow-auto pr-1 lg:grid-cols-3 xl:grid-cols-4">
              {NAV_GROUPS.map((g) => {
                const Icon = g.icon;
                return (
                  <div class="group rounded-xl border border-border/70 bg-[#ffffff] p-3 transition-colors hover:border-primary/25 hover:bg-secondary dark:border-border/80 dark:bg-[#000000] dark:hover:bg-secondary">
                    <a href={`/services/${g.slug}`} class="flex items-center gap-2.5">
                      <span class="grid h-8 w-8 place-items-center rounded-lg bg-secondary text-primary ring-1 ring-primary/10 transition-colors group-hover:bg-primary group-hover:text-primary-foreground"><Icon class="h-4 w-4" /></span>
                      <span class="font-display text-sm font-bold leading-tight text-foreground transition-colors group-hover:text-primary">{g.name}</span>
                    </a>
                    {g.subs.length > 0 && (
                      <ul class="mt-2 space-y-1 pl-10">
                        {g.subs.map((s) => (
                          <li><a href={`/services/${s.slug}`} class="block rounded-md px-2 py-1 text-xs font-medium leading-snug text-muted-foreground transition-colors hover:bg-card hover:text-primary">{s.name}</a></li>
                        ))}
                      </ul>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
      <a href="/blog" data-nav-close class="inline-flex items-center rounded-full px-4 py-2 text-muted-foreground hover:bg-card hover:text-foreground transition-colors">Blog</a>
      <a href="/#why" data-nav-close class="inline-flex items-center rounded-full px-4 py-2 text-muted-foreground hover:bg-card hover:text-foreground transition-colors">Why Us</a>
      <a href="/#contact" data-nav-close class="inline-flex items-center rounded-full px-4 py-2 text-muted-foreground hover:bg-card hover:text-foreground transition-colors">Contact</a>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/#contact" data-nav-close class="hidden lg:inline-flex items-center gap-2 rounded-full bg-primary text-primary-foreground px-5 py-2.5 text-sm font-bold hover:brightness-105 active:scale-[0.98] transition">
        Get a Quote <ArrowRight class="w-4 h-4" />
      </a>
      <button type="button" data-theme-toggle aria-label="Switch to dark mode" class="grid h-10 w-10 place-items-center rounded-full border border-border/80 bg-card/80 text-foreground shadow-sm backdrop-blur hover:bg-secondary active:scale-[0.96] transition">
        <Moon data-theme-icon-moon class="h-4 w-4 block dark:hidden" />
        <Sun data-theme-icon-sun class="h-4 w-4 hidden dark:block" />
      </button>
      <button data-menu-button class="lg:hidden grid h-10 w-10 place-items-center rounded-full border border-border/80 bg-card/80 shadow-sm" aria-label="Menu" aria-expanded="false">
        <Menu data-menu-icon class="w-5 h-5" />
        <X data-close-icon class="w-5 h-5 hidden" />
      </button>
    </div>
  </div>
  <div data-mobile-menu data-open="false" class="pointer-events-auto mx-auto mt-2 max-w-[72rem] rounded-[1.5rem] border border-border/80 bg-card/96 px-5 py-5 flex-col gap-1 max-h-[82vh] overflow-auto hidden backdrop-blur-2xl data-[open=true]:flex data-[open=true]:animate-in data-[open=true]:fade-in data-[open=true]:slide-in-from-top-2 lg:hidden">
    <button type="button" data-mobile-services-button aria-expanded="false" class="flex w-full items-center justify-between text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">
      Services <ChevronDown data-mobile-services-chevron class="w-4 h-4 transition-transform" />
    </button>
    <div data-mobile-services-list data-open="false" class="max-h-0 overflow-hidden opacity-0 transition-all duration-200 ease-out data-[open=true]:max-h-[70vh] data-[open=true]:opacity-100">
      {NAV_GROUPS.map((g) => {
        const Icon = g.icon;
        return (
          <div class="rounded-xl border border-border/60 bg-background/55 px-3 py-1.5 last:mb-0" data-mobile-service={g.slug}>
            {g.subs.length > 0 ? (
              <button type="button" data-mobile-service-toggle aria-expanded="false" class="flex w-full items-center text-left rounded-lg transition-colors hover:text-primary">
                <span class="flex flex-1 items-center gap-2 py-2.5 text-sm font-semibold">
                  <Icon class="w-4 h-4 text-primary" /> {g.name}
                </span>
                <span class="p-2" aria-hidden="true">
                  <ChevronDown class="w-4 h-4 transition-transform" data-mobile-service-chevron />
                </span>
              </button>
            ) : (
              <div class="flex items-center">
                <a href={`/services/${g.slug}`} class="flex items-center gap-2 py-2.5 text-sm font-semibold flex-1">
                  <Icon class="w-4 h-4 text-primary" /> {g.name}
                </a>
              </div>
            )}
            {g.subs.length > 0 && (
              <ul data-mobile-service-panel data-open="false" class="max-h-0 overflow-hidden pl-6 opacity-0 transition-all duration-200 ease-out data-[open=true]:max-h-96 data-[open=true]:pb-2 data-[open=true]:opacity-100">
                {g.subs.map((s) => <li><a href={`/services/${s.slug}`} class="block text-xs text-muted-foreground py-1">{s.name}</a></li>)}
              </ul>
            )}
          </div>
        );
      })}
    </div>
    <a href="/blog" class="text-sm font-semibold py-2.5 mt-1">Blog</a>
    <a href="/#why" class="text-sm font-semibold py-2.5">Why Us</a>
    <a href="/#contact" class="rounded-full bg-primary text-primary-foreground px-5 py-2.5 text-sm font-semibold text-center mt-2">Get a Quote</a>
  </div>
</header>
