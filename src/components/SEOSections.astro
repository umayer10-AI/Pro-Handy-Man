---
import { Star, Award, CheckCircle2 } from '@lucide/astro';
import { ALL_TESTIMONIALS, AWARDS, PORTFOLIO, LOCATION_DETAILS } from '@/data/seoSections.js';

const {
  sections = ['testimonials', 'awards', 'portfolio', 'locations'],
  testimonialLimit = 8,
  testimonialTitle = 'What Singapore homeowners say about us',
  testimonialSubtitle = 'Over 1,200 five-star reviews from HDB flat and condo owners across Singapore.',
  portfolioLimit = 6,
} = Astro.props;

const testimonials = ALL_TESTIMONIALS.slice(0, testimonialLimit);
const portfolio = PORTFOLIO.slice(0, portfolioLimit);
const show = (name) => sections.includes(name);
---

{show('testimonials') && (
  <section id="testimonials" class="py-24 md:py-28 bg-secondary/40">
    <div class="mx-auto max-w-[72rem] px-5">
      <div class="max-w-xl mb-12 reveal">
        <span class="text-sm font-semibold text-accent uppercase tracking-wider">Customer Reviews</span>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl mt-2">{testimonialTitle}</h2>
        <p class="text-muted-foreground mt-3">{testimonialSubtitle}</p>
        <div class="flex flex-wrap items-center gap-4 mt-4">
          <div class="flex gap-0.5 text-accent">{Array.from({ length: 5 }).map(() => <Star class="w-5 h-5 fill-current" />)}</div>
          <span class="font-display font-bold text-2xl">4.9</span>
          <span class="text-muted-foreground text-sm">/ 5 based on 1,200+ reviews</span>
        </div>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {testimonials.map((t, i) => (
          <article class="reveal rounded-[1.35rem] bg-card border border-border/80 p-6 flex flex-col" style={`transition-delay:${i * 55}ms`}>
            <div class="flex gap-0.5 text-accent">{Array.from({ length: t.rating }).map(() => <Star class="w-4 h-4 fill-current" />)}</div>
            <p class="text-sm text-muted-foreground mt-3 flex-1">"{t.text}"</p>
            <div class="mt-4 pt-4 border-t border-border">
              <p class="font-semibold text-sm">{t.name}</p>
              <p class="text-xs text-muted-foreground">{t.area}</p>
              <p class="text-xs text-primary font-medium mt-0.5">{t.service}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-10 rounded-[1.35rem] bg-card border border-border/80 p-6 flex flex-col sm:flex-row items-center gap-6 justify-between shadow-sm reveal-scale">
        <div>
          <p class="font-display font-bold text-lg">Join 1,200+ satisfied Singapore homeowners</p>
          <p class="text-muted-foreground text-sm mt-1">Rated 4.9 stars across Google, Facebook, and Carousell.</p>
        </div>
        <a href="/#contact" class="shrink-0 inline-flex items-center gap-2 rounded-full bg-accent text-accent-foreground px-6 py-3.5 font-semibold hover:brightness-95 active:scale-[0.98] transition">
          Book your handyman today
        </a>
      </div>
    </div>
  </section>
)}

{show('awards') && (
  <section id="awards" class="py-24 md:py-28 bg-secondary/30">
    <div class="mx-auto max-w-[72rem] px-5">
      <div class="text-center max-w-xl mx-auto mb-14 reveal">
        <span class="text-sm font-semibold text-accent uppercase tracking-wider">Recognition & Certifications</span>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl mt-2">Awards &amp; industry recognition</h2>
        <p class="text-muted-foreground mt-3">Pro Handyman SG.Com is proud to be recognised for service excellence, professional standards, and customer satisfaction across Singapore's home services industry.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {AWARDS.map((a, i) => (
          <article class="reveal rounded-[1.35rem] bg-card border border-border/80 p-6 flex flex-col" style={`transition-delay:${i * 70}ms`}>
            <div class="flex items-start gap-3 mb-4">
              <span class="grid place-items-center w-11 h-11 rounded-xl bg-primary/10 text-primary shrink-0"><Award class="w-5 h-5" /></span>
              <span class="rounded-full bg-accent/10 text-accent text-xs font-bold px-3 py-1">{a.year}</span>
            </div>
            <h3 class="font-display font-bold text-base leading-snug">{a.title}</h3>
            <p class="text-xs font-semibold text-primary mt-1">{a.body}</p>
            <p class="text-sm text-muted-foreground mt-3 flex-1">{a.desc}</p>
          </article>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4 text-sm text-muted-foreground reveal">
        {['BCA Registered', 'CaseTrust Accredited', 'HDB Approved Contractor', 'SPRING Singapore SME', 'NEA Licensed'].map((cert) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-card/80 px-4 py-2 font-medium shadow-sm">
            <CheckCircle2 class="w-3.5 h-3.5 text-accent" /> {cert}
          </span>
        ))}
      </div>
    </div>
  </section>
)}

{show('portfolio') && (
  <section id="portfolio" class="py-24 md:py-28">
    <div class="mx-auto max-w-[72rem] px-5">
      <div class="max-w-xl mb-12 reveal">
        <span class="text-sm font-semibold text-accent uppercase tracking-wider">Recent Projects</span>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl mt-2">Our completed works across Singapore</h2>
        <p class="text-muted-foreground mt-3">Real projects, real results. Browse some of our recently completed handyman, renovation, and maintenance jobs for HDB flat and condo owners across Singapore.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {portfolio.map((p, i) => (
          <article class="group reveal rounded-[1.35rem] bg-card border border-border/80 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300" style={`transition-delay:${i * 60}ms`}>
            <div class="h-48 overflow-hidden relative">
              <img src={p.img} alt={`${p.title} — Pro Handyman SG.Com completed project Singapore`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <span class="absolute top-3 left-3 rounded-full bg-primary/90 text-primary-foreground text-xs font-semibold px-3 py-1">{p.category}</span>
            </div>
            <div class="p-5">
              <h3 class="font-display font-bold text-base leading-snug">{p.title}</h3>
              <p class="text-sm text-muted-foreground mt-2 leading-relaxed">{p.desc}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="text-center text-sm text-muted-foreground mt-10 reveal">
        Want a similar result for your home? <a href="/#contact" class="font-semibold text-primary hover:underline">Request a free quote</a> and we'll get started.
      </p>
    </div>
  </section>
)}

{show('locations') && (
  <section id="locations" class="py-24 md:py-28">
    <div class="mx-auto max-w-[72rem] px-5">
      <div class="max-w-xl mb-12 reveal">
        <span class="text-sm font-semibold text-accent uppercase tracking-wider">Service Locations</span>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl mt-2">Handyman services across all Singapore districts</h2>
        <p class="text-muted-foreground mt-3">We operate islandwide — from Woodlands in the north to Changi in the east, and Jurong in the west. No job is too far for our team of licensed Singapore handymen.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {LOCATION_DETAILS.map((loc, i) => (
          <article class="reveal rounded-[1.2rem] bg-card border border-border/80 p-5" style={`transition-delay:${i * 55}ms`}>
            <h3 class="font-display font-bold text-base flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent inline-block"></span>
              {loc.area}
            </h3>
            <p class="text-sm text-muted-foreground mt-2">{loc.desc}</p>
          </article>
        ))}
      </div>
      <div class="rounded-[1.35rem] bg-primary/5 border border-primary/20 p-6 text-center shadow-sm reveal-scale">
        <p class="font-display font-semibold text-lg">We cover every HDB town and residential district in Singapore</p>
        <p class="text-muted-foreground text-sm mt-2">Central Area · Ang Mo Kio · Bedok · Bishan · Bukit Batok · Bukit Merah · Bukit Timah · Choa Chu Kang · Clementi · Geylang · Hougang · Jurong East · Jurong West · Kallang · Marine Parade · Novena · Pasir Ris · Punggol · Queenstown · Sembawang · Sengkang · Serangoon · Tampines · Toa Payoh · Woodlands · Yishun</p>
      </div>
    </div>
  </section>
)}
